# Copy to site/marlowe.env on Marlowe and fill in the project directory name.
# Do not add credentials or Duo information here.
export MARLOWE_PROJECT="REPLACE_WITH_PROJECT_ID"
export MARLOWE_ACCOUNT="marlowe-${MARLOWE_PROJECT}"
export MARLOWE_PARTITION="preempt"

# If `module spider julia` finds Julia 1.12, use its exact module name:
# export JULIA_MODULE="julia/1.12.6"
# Otherwise point at a Linux Julia 1.12 executable installed in project space:
# export JULIA_BIN="/projects/${MARLOWE_PROJECT}/software/julia-1.12.6/bin/julia"

# Adjust only after checking `module spider` on Marlowe.
export MHD_GPU_RUN_MODULES="nvhpc mps"
export MHD_GPU_BUILD_MODULES="nvhpc mps"
export MHD_PYTHON_MODULES=""

